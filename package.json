{
  "name": "forward-2026-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "FORWARD 2026 · There is more — The Hope campaign site (synthetic preview)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "assets:portraits": "node scripts/gen-portraits.mjs",
    "assets:audio": "python3 scripts/gen-audio.py",
    "assets:font": "python3 scripts/subset-font.py",
    "assets:brand": "python3 scripts/gen-brand.py"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}

# ==============================================================================
# FRONTEND PUBLIC VARIABLES (Vite bundle)
# Copy to .env.local for local overrides. Every value here is public in the browser.
# Never put backend secrets (such as ADMIN_API_TOKEN) in any VITE_ variable!
# ==============================================================================

# "mock" (default): in-browser fake API with synthetic data. "live": call VITE_API_BASE_URL.
VITE_API_MODE=mock
# Origin of the real backend when VITE_API_MODE=live. Empty = same origin (/api/...).
VITE_API_BASE_URL=

# Official FORWARD giving page (must be https). Unset = Give buttons stay safely disabled.
VITE_GIVE_URL=

# GA4 Measurement ID (G-XXXXXXX). Unset = no Google Analytics script is loaded.
VITE_GA4_MEASUREMENT_ID=

# Cloudflare Turnstile site key (public). Unset = no widget (mock mode ignores it).
# Test Key (always passes): 1x00000000000000000000AA
VITE_TURNSTILE_SITE_KEY=

# Prayer Map. Keep EMBED false until the Prayer Map site allows this domain to frame it
# (it currently sends frame-ancestors 'none' / X-Frame-Options: DENY).
VITE_PRAYER_MAP_URL=https://prayer-map-omega.vercel.app/
VITE_PRAYER_MAP_EMBED_ENABLED=false

# Show the "SYNTHETIC PREVIEW" marker in the header. Turn off only with real content.
VITE_SHOW_PREVIEW_BADGE=true

# ==============================================================================
# BACKEND & CLOUDFLARE PAGES SECRETS (Do NOT expose to client!)
# For local wrangler development, put these in `.dev.vars` (never commit .dev.vars).
# In Cloudflare Pages, configure these in Project Settings -> Environment Variables.
# ==============================================================================
# TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# TURNSTILE_ALLOWED_HOSTNAME=26fwd-staging.pages.dev
# ADMIN_API_TOKEN=replace_with_a_random_token_at_least_32_characters
# RATE_LIMIT_SALT=replace_with_a_random_salt_string
# CARD_SUBMISSIONS_ENABLED=true

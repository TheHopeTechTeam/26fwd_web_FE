# Copy to .env.local for local overrides. Every value here is public (it ends up in
# the browser bundle) — never put secrets such as the admin API token in a VITE_ var.

# "mock" (default): in-browser fake API with synthetic data. "live": call VITE_API_BASE_URL.
VITE_API_MODE=mock
# Origin of the real backend when VITE_API_MODE=live. Empty = same origin (/api/...).
VITE_API_BASE_URL=

# Official FORWARD giving page (must be https). Unset = Give buttons stay safely disabled.
VITE_GIVE_URL=

# GA4 Measurement ID (G-XXXXXXX). Unset = no Google Analytics script is loaded.
VITE_GA4_MEASUREMENT_ID=

# Cloudflare Turnstile site key (public). Unset = no widget (mock mode ignores it).
VITE_TURNSTILE_SITE_KEY=

# Prayer Map. Keep EMBED false until the Prayer Map site allows this domain to frame it
# (it currently sends frame-ancestors 'none' / X-Frame-Options: DENY).
VITE_PRAYER_MAP_URL=https://prayer-map-omega.vercel.app/
VITE_PRAYER_MAP_EMBED_ENABLED=false

# Show the "SYNTHETIC PREVIEW" marker in the header. Turn off only with real content.
VITE_SHOW_PREVIEW_BADGE=true

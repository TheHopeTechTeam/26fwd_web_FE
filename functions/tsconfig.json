{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["**/*.ts"],
  // contract.test.ts imports the browser client (src/api/client.ts), which uses browser-only
  // fetch options such as cache: 'default' that the Workers types reject. The browser code is
  // typechecked by the root tsconfig; the test itself still runs under vitest.
  "exclude": ["api/contract.test.ts"]
}
